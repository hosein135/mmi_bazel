"""Micro Magic CAD: Nix prepares the toolchain, Bazel compiles the sources."""

module(
    name = "mmi_bazel",
    version = "0.1.0",
    bazel_compatibility = [">=7.0.0"],
)

bazel_dep(name = "platforms", version = "0.0.10")

mmi_nix_env = use_repo_rule("//bazel:nix_env.bzl", "mmi_nix_env")

mmi_nix_env(
    name = "mmi_nix_env",
    dump = "//:nix/dump-env.py",
    flake = "//:flake.nix",
    lock = "//:flake.lock",
)
